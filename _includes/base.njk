    <li><a href="/#about" onclick="closeMobileMenu()"><span class="sr">O nama</span><span class="en">About</span></a></li>
    <li><a href="/#projects" onclick="closeMobileMenu()"><span class="sr">Projekti</span><span class="en">Projects</span></a></li>
