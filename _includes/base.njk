<!DOCTYPE html>
<html lang="sr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="format-detection" content="telephone=no">
<title>{{ title }} — Rotari klub Banja Luka</title>
<meta name="robots" content="index, follow">
<link rel="canonical" href="https://rotary-banjaluka.org{{ page.url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@300;400;600&display=swap" rel="stylesheet">
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<style>
  :root {
    --gold: #C8A84B;
    --gold-light: #E2C97E;
    --navy: #0A1628;
    --navy-mid: #132040;
    --cream: #F5F0E8;
    --cream-dark: #EDE5D4;
    --text: #1A1A2E;
    --text-light: #5A5A72;
    --white: #FFFFFF;
    --accent: #A01B2C;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Source Sans 3', sans-serif;
    background: var(--cream);
    color: var(--text);
    overflow-x: hidden;
  }

  /* ── LANGUAGE SWITCHING ── */
  .en { display: none; }
  .sr { display: inline; }
  span.en { display: none; }
  span.sr { display: inline; }
  div.en { display: none; }
  div.sr { display: block; }
  p.en { display: none; }
  p.sr { display: block; }
  h1.en { display: none; }
  h1.sr { display: block; }
  h2.en { display: none; }
  h2.sr { display: block; }
  li.en { display: none; }
  li.sr { display: list-item; }

  body.lang-en .en { display: block; }
  body.lang-en .sr { display: none !important; }
  body.lang-en span.en { display: inline !important; }
  body.lang-en span.sr { display: none !important; }
  body.lang-en div.en { display: block !important; }
  body.lang-en div.sr { display: none !important; }
  body.lang-en p.en { display: block !important; }
  body.lang-en p.sr { display: none !important; }
  body.lang-en h1.en { display: block !important; }
  body.lang-en h1.sr { display: none !important; }
  body.lang-en h2.en { display: block !important; }
  body.lang-en h2.sr { display: none !important; }
  body.lang-en li.en { display: list-item !important; }
  body.lang-en li.sr { display: none !important; }
  body.lang-en a.en { display: inline !important; }
  body.lang-en a.sr { display: none !important; }

  /* ── NAV ── */
  .lang-btn {
    padding: 8px 18px;
    font-family: 'Source Sans 3', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    border: none;
    background: transparent;
    color: rgba(255,255,255,0.5);
    transition: all 0.3s;
  }
  .lang-btn.active { color: var(--gold); }
  .lang-btn:hover { color: var(--gold-light); }
  .nav-fb-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    font-family: 'Source Sans 3', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--navy);
    background: var(--gold);
    border: 2px solid var(--gold);
    transition: all 0.3s;
    white-space: nowrap;
    box-shadow: 0 2px 12px rgba(200,168,75,0.4);
    flex-shrink: 0;
    margin-left: 8px;
  }
  .nav-fb-btn:hover {
    background: var(--gold-light);
    border-color: var(--gold-light);
    transform: translateY(-1px);
  }
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 5vw;
    height: 72px;
    background: rgba(10,22,40,0.97);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(200,168,75,0.2);
  }
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }
  .gear-svg { width: 40px; height: 40px; }
  .nav-logo-text { line-height: 1.1; }
  .nav-logo-text span:first-child {
    display: block;
    font-family: 'Playfair Display', serif;
    font-size: 16px;
    color: var(--gold);
    letter-spacing: 0.04em;
  }
  .nav-logo-text span:last-child {
    display: block;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
  }
  .nav-links {
    display: flex;
    gap: 16px;
    list-style: none;
    align-items: center;
  }
  .nav-links a {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    transition: color 0.3s;
    white-space: nowrap;
  }
  .nav-links a:hover { color: var(--gold); }

  /* ── HAMBURGER & MOBILE MENU ── */
  .hamburger {
    display: none; flex-direction: column; gap: 5px; cursor: pointer;
    padding: 8px; background: none; border: none; z-index: 1002;
  }
  .hamburger span {
    width: 24px; height: 2px; background: var(--gold);
    transition: all 0.35s cubic-bezier(0.4,0,0.2,1); display: block;
  }
  .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .mobile-nav {
    display: none; position: fixed;
    top: 72px; left: 0; right: 0;
    background: rgba(10,22,40,0.99); backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(200,168,75,0.2);
    z-index: 998;
    transform: translateY(-110%);
    transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
    padding: 8px 0 16px;
  }
  .mobile-nav.open { transform: translateY(0); }
  .mobile-nav ul { list-style: none; padding: 0; }
  .mobile-nav ul li a {
    display: block; width: 100%; text-align: left;
    padding: 14px 5vw; font-size: 13px; letter-spacing: 0.15em;
    text-transform: uppercase; color: rgba(255,255,255,0.75);
    text-decoration: none; background: none; border: none;
    font-family: 'Source Sans 3', sans-serif;
    border-left: 3px solid transparent;
    transition: color 0.2s, background 0.2s;
  }
  .mobile-nav ul li a:hover { color: var(--gold); background: rgba(200,168,75,0.05); border-left-color: var(--gold); }
  .mobile-nav-divider { height: 1px; background: rgba(200,168,75,0.1); margin: 8px 5vw; }
  .mobile-lang { display: flex; gap: 8px; padding: 12px 5vw 4px; }
  .mobile-lang button {
    padding: 8px 20px; font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase;
    border: 1px solid rgba(200,168,75,0.3); background: transparent;
    color: rgba(255,255,255,0.5); cursor: pointer; font-family: 'Source Sans 3', sans-serif;
    transition: all 0.2s;
  }
  .mobile-lang button.active { background: var(--gold); color: var(--navy); border-color: var(--gold); }

  /* ── PAGE CONTENT ── */
  .page-wrap {
    padding-top: 72px;
    min-height: 100vh;
  }
  .page-hero {
    background: var(--navy);
    padding: 60px 5vw 48px;
    border-bottom: 1px solid rgba(200,168,75,0.2);
  }
  .page-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    text-decoration: none;
    margin-bottom: 24px;
    transition: gap 0.2s;
  }
  .page-back:hover { gap: 12px; }
  .page-tag {
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 12px;
  }
  .page-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 52px);
    color: var(--white);
    line-height: 1.15;
    margin-bottom: 16px;
  }
  .page-date {
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .page-body {
    max-width: 820px;
    margin: 0 auto;
    padding: 60px 5vw 80px;
  }
  .page-photo {
    width: 100%;
    max-height: 520px;
    object-fit: cover;
    object-position: center top;
    margin-bottom: 40px;
    display: block;
  }
  .page-text {
    font-size: 17px;
    line-height: 1.85;
    color: var(--text-light);
  }
  .page-text p { margin-bottom: 20px; }
  .page-text strong { color: var(--text); }

  /* ── FOOTER ── */
  .gold-divider {
    height: 2px;
    background: linear-gradient(to right, transparent, var(--gold), transparent);
    opacity: 0.4;
  }
  footer {
    background: var(--navy);
    padding: 60px 5vw 40px;
    border-top: 1px solid rgba(200,168,75,0.2);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 60px;
    margin-bottom: 48px;
  }
  .footer-brand p { font-size: 14px; color: rgba(255,255,255,0.4); line-height: 1.7; margin-top: 16px; max-width: 280px; }
  .footer-col h4 { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); margin-bottom: 20px; }
  .footer-col ul { list-style: none; }
  .footer-col ul li { margin-bottom: 10px; }
  .footer-col ul li a { font-size: 14px; color: rgba(255,255,255,0.45); text-decoration: none; transition: color 0.3s; }
  .footer-col ul li a:hover { color: var(--gold); }
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding-top: 24px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .footer-bottom p { font-size: 12px; color: rgba(255,255,255,0.25); }
  .footer-motto { font-family: 'Playfair Display', serif; font-style: italic; color: var(--gold); font-size: 14px; }

  @media (max-width: 900px) {
    .hamburger { display: flex; }
    .mobile-nav { display: block; }
    .nav-links { display: none; }
    .footer-grid { grid-template-columns: 1fr; gap: 32px; }
    .nav-fb-btn { margin-right: 52px; margin-left: 0; }
  }
</style>
</head>
