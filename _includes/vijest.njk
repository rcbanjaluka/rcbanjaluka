---
layout: base.njk
eleventyExcludeFromCollections: false
---
<section class="page-hero">
  <div style="max-width:820px;margin:0 auto;">
    <a href="/#news" class="page-back">
      <span>←</span>
      <span class="sr">Nazad na vijesti</span>
      <span class="en">Back to news</span>
    </a>
    <p class="page-tag sr">Vijesti</p>
    <p class="page-tag en">News</p>
    <h1 class="page-title sr">{{ naslov_sr }}</h1>
    <h1 class="page-title en">{{ naslov_en }}</h1>
    <p class="page-date">{{ datum | datumFormat }}</p>
  </div>
</section>

<div class="page-body">
  {%- if fotografija_1 %}
  <img src="{{ fotografija_1 }}" alt="{{ naslov_sr }}" class="page-photo">
  {%- endif %}

  <div class="page-text sr">
    {%- if tekst_sr %}
    {{ tekst_sr | safe }}
    {%- else %}
    <p>{{ opis_sr }}</p>
    {%- endif %}
  </div>

  <div class="page-text en">
    {%- if tekst_en %}
    {{ tekst_en | safe }}
    {%- else %}
    <p>{{ opis_en }}</p>
    {%- endif %}
  </div>

  {%- if fotografija_2 or fotografija_3 %}
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:40px;">
    {%- if fotografija_2 %}
    <img src="{{ fotografija_2 }}" alt="" style="width:100%;object-fit:cover;max-height:300px;">
    {%- endif %}
    {%- if fotografija_3 %}
    <img src="{{ fotografija_3 }}" alt="" style="width:100%;object-fit:cover;max-height:300px;">
    {%- endif %}
  </div>
  {%- endif %}

  <div style="margin-top:48px;padding-top:32px;border-top:1px solid rgba(0,0,0,0.08);">
    <a href="/#news" class="page-back">
      <span>←</span>
      <span class="sr">Nazad na vijesti</span>
      <span class="en">Back to news</span>
    </a>
  </div>
</div>
